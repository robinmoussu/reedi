"5e2b9d4 release: install with a shell script instead of the Makefile, and check the downloaded archive Noah   "
"Petit 28/09/2026                                                                                              "
"                                                                                                              "
"The Makefile only worked with GNU make, a POSIX shell script works everywhere.                                "
"The archive is now checked before being installed.                                                            "
"                                                                                                              "
"src/release.rs                                                                                                "
"──────────────────────────────────────────────────────────────────────────────────────────────────────────────"
"│  9 │ /// Installs the release archive at `path` in  ↵│  9 │ /// Installs the release archive at `path` in  ↵"
"│    │ `prefix`.                                       │    │ `prefix`.                                       "
"│ 10 │ pub fn install(path: &Path, prefix: &Path) ->  ↵│ 10 │ pub fn install(path: &Path, prefix: &Path) ->  ↵"
"│    │ io::Result<()> {                                │    │ io::Result<()> {                                "
"│ 11 │     let archive = Archive::open(path)?;         │ 11 │     let archive = Archive::open(path)?;         "
"│    │                                                 │ 12 │     if !archive.has_valid_checksum()? {         "
"│    │                                                 │ 13 │         return Err(io::Error::other("the       ↵"
"│    │                                                 │    │ checksum of the archive is invalid"));          "
"│    │                                                 │ 14 │     }                                           "
"│ 12 │     archive.extract(prefix)?;                   │ 15 │     archive.extract(prefix)?;                   "
"│ 13 │     Ok(())                                      │ 16 │     Ok(())                                      "
"│ 14 │ }                                               │ 17 │ }                                               "
"                                                                                                              "
"│ 20 │                                                 │ 23 │                                                 "
"│ 21 │ /// Removes the temporary files of the previous↵│ 24 │ /// Removes the temporary files of the previous↵"
"│    │  installations.                                 │    │  installations.                                 "
"│ 22 │ pub fn clean(directory: &Path) ->              ↵│ 25 │ pub fn clean(directory: &Path) ->              ↵"
"│    │ io::Result<()> {                                │    │ io::Result<()> {                                "
"│ 23 │     // Kept for compatibility with the releases↵│    │                                                 "
"│    │  older than v0.1.                               │    │                                                 "
"│ 24 │     let legacy = directory.join("reedi.old");   │    │                                                 "
"│ 25 │     if legacy.exists() {                        │    │                                                 "
"│ 26 │         fs::remove_file(legacy)?;               │    │                                                 "
"│ 27 │     }                                           │    │                                                 "
"│ 28 │     fs::remove_dir_all(directory.join("tmp"))   │ 26 │     fs::remove_dir_all(directory.join("tmp"))   "
"│ 29 │ }                                               │ 27 │ }                                               "
"                                                                                                              "
"renamed: src/hash.rs ⟶   src/digest.rs                                                                        "
"──────────────────────────────────────────────────────────────────────────────────────────────────────────────"
"│ 1 │ //! Hash of the release archives.                │ 1 │ //! Digest of the release archives.              "
"│ 2 │                                                  │ 2 │                                                  "
"│ 3 │ use sha2::Digest;                                │ 3 │ use sha2::Digest;                                "
"│ 4 │ use sha2::Sha256;                                │ 4 │ use sha2::Sha256;                                "
"                                                                                                              "
"scripts/install.sh                                                                                            "
"──────────────────────────────────────────────────────────────────────────────────────────────────────────────"
"│ 3 │                                                  │ 3 │                                                  "
"│ 4 │ prefix="${PREFIX:-/usr/local}"                   │ 4 │ prefix="${PREFIX:-/usr/local}"                   "
"│ 5 │                                                  │ 5 │                                                  "
"│ 6 │ make build                                       │   │                                                  "
"│   │                                                  │ 6 │ cargo build --release                            "
"│   │                                                  │ 7 │ sha256sum --check reedi.sha256                   "
"│ 7 │ install -m 755 target/release/reedi "$prefix/   ↵│ 8 │ install -m 755 target/release/reedi "$prefix/   ↵"
"│   │ bin/reedi"                                       │   │ bin/reedi"                                       "
"│ 8 │ echo "reedi installed in $prefix/bin"            │ 9 │ echo "reedi installed in $prefix/bin"            "
"                                                                                                              "
